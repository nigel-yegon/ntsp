// prisma/schema.prisma

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Users & roles ──────────────────────────────────────────────

enum Role {
  EMPLOYER
  CUSTOMER
  BUSINESS
  VERIFIER
  COMMITTEE_MEMBER
  PERMANENT_SECRETARY
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  phone         String?
  emailVerified DateTime?
  image         String?
  passwordHash  String?

  role Role @default(EMPLOYER)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NextAuth
  accounts Account[]

  // ── Work permit side (employers)
  applicationsSubmitted Application[]      @relation("SubmittedBy")
  events                ApplicationEvent[]
  committeeVotes        CommitteeVote[]
  assignments           Assignment[]
  documentsReviewed     Document[]         @relation("DocumentReviewer")

  // ── Business side
  businessProfile           BusinessProfile?
  ownedAccommodations       Accommodation[]
  ownedTourPackages         TourPackage[]
  bookingRequestsAsBusiness Booking[]        @relation("BookingBusiness")
  threadsAsBusiness         MessageThread[]  @relation("ThreadBusiness")

  // ── Customer side
  bookingsAsCustomer Booking[]       @relation("BookingCustomer")
  threadsAsCustomer  MessageThread[] @relation("ThreadCustomer")
  messages           Message[]

  // ── Incident review side (admin)
  incidentsReviewed Incident[] @relation("IncidentReviewer")
  incidentsEscalated Incident[] @relation("IncidentEscalator")   

  @@index([role])
  @@index([companyId])
}

// ─── OAuth accounts ────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Business profile ──────────────────────────────────────────

enum BusinessVerification {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

model BusinessProfile {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName   String
  registrationNo String?
  kraPin         String?
  description    String?
  logoUrl        String?
  contactEmail   String
  contactPhone   String?
  website        String?

  verificationStatus BusinessVerification @default(PENDING)
  approvedAt         DateTime?
  approvedById       String?
  rejectionReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verificationStatus])
}

// ─── Company (the employer) ────────────────────────────────────

model Company {
  id               String   @id @default(cuid())
  name             String
  registrationNo   String   @unique
  kraPin           String?
  tourismLicenceNo String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users        User[]
  applications Application[]

  @@index([registrationNo])
}

// ─── Applications ──────────────────────────────────────────────

enum PermitClass {
  CLASS_G
  CLASS_D
  SPECIAL_PASS
}

enum ApplicationType {
  FIRST_APPLICATION
  RENEWAL
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_PERUSAL
  UNDER_VERIFICATION
  AWAITING_COMMITTEE
  COMMITTEE_APPROVED
  COMMITTEE_DECLINED
  AWAITING_PS_APPROVAL
  PS_APPROVED
  PS_DECLINED
  WITHDRAWN
  FORWARDED_TO_INTERIOR
}

model Application {
  id          String            @id @default(cuid())
  referenceNo String            @unique
  status      ApplicationStatus @default(DRAFT)

  submittedById String
  submittedBy   User    @relation("SubmittedBy", fields: [submittedById], references: [id])
  companyId     String
  company       Company @relation(fields: [companyId], references: [id])

  permitClass     PermitClass
  applicationType ApplicationType

  applicantName        String
  applicantNationality String
  applicantPassportNo  String
  applicantEmail       String
  applicantPhone       String
  purposeStatement     String?

  documents   Document[]
  events      ApplicationEvent[]
  votes       CommitteeVote[]
  assignments Assignment[]

  submittedAt           DateTime?
  perusalStartedAt      DateTime?
  verificationStartedAt DateTime?
  committeeDecidedAt    DateTime?
  psDecidedAt           DateTime?
  forwardedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([submittedById])
  @@index([companyId])
  @@index([applicantEmail])
}

// ─── Documents ─────────────────────────────────────────────────

enum DocumentReviewStatus {
  PENDING
  ACCEPTED
  REJECTED
  NEEDS_RESUBMISSION
}

model Document {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  slotId     String
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String
  uploadedAt DateTime @default(now())

  perusalStatus      DocumentReviewStatus @default(PENDING)
  verificationStatus DocumentReviewStatus @default(PENDING)
  reviewNotes        String?

  reviewedById String?
  reviewedBy   User?     @relation("DocumentReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  @@unique([applicationId, slotId, fileName])
  @@index([applicationId])
  @@index([slotId])
  @@index([reviewedById])
}

// ─── Workflow events ───────────────────────────────────────────

enum EventType {
  SUBMITTED
  PERUSAL_STARTED
  DOCUMENT_PERUSED
  VERIFICATION_STARTED
  DOCUMENT_VERIFIED
  ESCALATED_TO_COMMITTEE
  COMMITTEE_VOTE_CAST
  COMMITTEE_APPROVED
  COMMITTEE_DECLINED
  ESCALATED_TO_PS
  PS_APPROVED
  PS_DECLINED
  FORWARDED_TO_INTERIOR
  WITHDRAWN
  NOTE_ADDED
}

model ApplicationEvent {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  type     EventType
  actorId  String?
  actor    User?     @relation(fields: [actorId], references: [id])
  message  String?
  metadata Json?

  createdAt DateTime @default(now())

  @@index([applicationId, createdAt])
  @@index([actorId])
}

// ─── Committee votes ───────────────────────────────────────────

enum VoteDecision {
  APPROVE
  DECLINE
  ABSTAIN
}

model CommitteeVote {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  voterId String
  voter   User   @relation(fields: [voterId], references: [id])

  decision VoteDecision
  comment  String?

  createdAt DateTime @default(now())

  @@unique([applicationId, voterId])
  @@index([applicationId])
  @@index([voterId])
}

// ─── Assignment ────────────────────────────────────────────────

enum AssignmentRole {
  PERUSER
  VERIFIER
  COMMITTEE_CHAIR
  PS_REVIEWER
}

model Assignment {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  role        AssignmentRole
  assigneeId  String
  assignee    User           @relation(fields: [assigneeId], references: [id])
  assignedAt  DateTime       @default(now())
  completedAt DateTime?

  @@unique([applicationId, role])
  @@index([assigneeId])
}

// ─── Bookings ──────────────────────────────────────────────────

enum BookingStatus {
  REQUESTED
  CONFIRMED
  DECLINED
  CANCELLED
  COMPLETED
}

model Booking {
  id String @id @default(cuid())

  customerId String
  customer   User   @relation("BookingCustomer", fields: [customerId], references: [id], onDelete: Cascade)

  businessId String
  business   User   @relation("BookingBusiness", fields: [businessId], references: [id])

  // Exactly one of accommodationId / tourPackageId is set.
  accommodationId Int?
  accommodation   Accommodation? @relation(fields: [accommodationId], references: [id])
  tourPackageId   Int?
  tourPackage     TourPackage?   @relation(fields: [tourPackageId], references: [id])

  checkIn  DateTime
  checkOut DateTime?
  guests   Int
  notes    String?

  status       BookingStatus @default(REQUESTED)
  respondedAt  DateTime?
  responseNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, createdAt])
  @@index([businessId, status])
  @@index([accommodationId])
  @@index([tourPackageId])
}

// ─── Message threads & messages ────────────────────────────────

enum ThreadSubject {
  ACCOMMODATION
  TOUR_PACKAGE
}

model MessageThread {
  id String @id @default(cuid())

  customerId String
  customer   User   @relation("ThreadCustomer", fields: [customerId], references: [id], onDelete: Cascade)

  businessId String
  business   User   @relation("ThreadBusiness", fields: [businessId], references: [id])

  subject ThreadSubject

  accommodationId Int?
  accommodation   Accommodation? @relation(fields: [accommodationId], references: [id])
  tourPackageId   Int?
  tourPackage     TourPackage?   @relation(fields: [tourPackageId], references: [id])

  subjectLabel String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@index([customerId, updatedAt])
  @@index([businessId, updatedAt])
}

model Message {
  id       String        @id @default(cuid())
  threadId String
  thread   MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  body String

  readByCustomer Boolean @default(false)
  readByBusiness Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
  @@index([authorId])
}

// ─── Contact Form Submission ────────────────────────────────────

model ContactSubmission {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  createdAt DateTime @default(now())
}

// ─── Blog posts ────────────────────────────────────────────────

model Post {
  id          Int       @id @default(autoincrement())
  title       String
  slug        String    @unique
  excerpt     String
  content     String
  coverImage  String?
  tags        String    @default("")
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
}

// ─── Destinations ──────────────────────────────────────────────

model Destination {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  slug        String  @unique
  county      String
  description String
  imageUrl    String?
// Geolocation — WGS84 decimal degrees. Nullable so existing
// rows don't break; set via the admin editor.
  latitude    Float?
  longitude   Float?

  featured    Boolean @default(false)
  order       Int     @default(0)
  published   Boolean @default(true)

  attractions Attraction[]
  packages    TourPackage[]
  stays       Accommodation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Attractions ───────────────────────────────────────────────

model Attraction {
  id            Int         @id @default(autoincrement())
  name          String
  slug          String      @unique
  description   String
  category      String
  imageUrl      String?
  latitude      Float?
  longitude     Float?
  destinationId Int
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  order         Int         @default(0)
  published     Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([destinationId])
}

// ─── Tour Packages ─────────────────────────────────────────────

model TourPackage {
  id            Int         @id @default(autoincrement())
  title         String
  slug          String      @unique
  summary       String
  description   String
  priceKes      Int
  durationDays  Int
  imageUrl      String?
  latitude      Float?
  longitude     Float?
  destinationId Int
  destination   Destination @relation(fields: [destinationId], references: [id])
  order         Int         @default(0)
  published     Boolean     @default(true)
  featured      Boolean     @default(false)

  // Nullable so the migration doesn't break existing rows. Backfilled
  // by the seed; enforced non-null at the app layer before a listing
  // is published.
  businessId String?
  business   User?           @relation(fields: [businessId], references: [id])
  bookings   Booking[]
  threads    MessageThread[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([destinationId])
  @@index([businessId])
}

// ─── Accommodations ────────────────────────────────────────────

model Accommodation {
  id            Int         @id @default(autoincrement())
  name          String
  slug          String      @unique
  type          String
  description   String
  location      String
  priceRange    String?
  imageUrl      String?
  latitude      Float?
  longitude     Float?
  destinationId Int
  destination   Destination @relation(fields: [destinationId], references: [id])
  order         Int         @default(0)
  published     Boolean     @default(true)

  // Nullable for the same reason as TourPackage above.
  businessId String?
  business   User?           @relation(fields: [businessId], references: [id])
  bookings   Booking[]
  threads    MessageThread[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([destinationId])
  @@index([businessId])
}

// ─── Events ────────────────────────────────────────────────────

model Event {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String
  startDate   DateTime
  endDate     DateTime?
  location    String
  imageUrl    String?
  featured    Boolean   @default(false)
  order       Int       @default(0)
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ─── Incidents ─────────────────────────────────────────────────

enum IncidentStatus {
  OPEN
  UNDER_REVIEW
  ESCALATED
  RESOLVED
  CLOSED
}

enum IncidentCategory {
  WILDLIFE
  SAFETY
  OPERATOR
  FACILITY
  GUIDES
  OTHER
}

model Incident {
  id          String           @id @default(cuid())
  referenceNo String           @unique
  status      IncidentStatus   @default(OPEN)
  category    IncidentCategory @default(OTHER)

  // Reporter — optional, form supports anonymous submissions
  reporterName  String?
  reporterEmail String?
  reporterPhone String?

  // What happened
  title       String
  description String
  location    String?
  occurredAt  DateTime?
  reportedAt  DateTime  @default(now())

  attachments IncidentAttachment[]

  // Review trail
  reviewedById String?
  reviewedBy   User?     @relation("IncidentReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNotes  String?

   // Escalation trail (set when status → ESCALATED)
  escalatedTo   String?
  escalatedAt   DateTime?
  escalatedById String?
  escalatedBy   User?     @relation("IncidentEscalator", fields: [escalatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([reportedAt])
  @@index([category])
  @@index([reviewedById])
  @@index([escalatedById])
}

model IncidentAttachment {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String
  uploadedAt DateTime @default(now())

  @@index([incidentId])
  
}
