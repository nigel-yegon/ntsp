// prisma/schema.prisma

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Users & roles ──────────────────────────────────────────────

enum Role {
  EMPLOYER
  VERIFIER
  COMMITTEE_MEMBER
  PERMANENT_SECRETARY
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String?
  role         Role
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  applicationsSubmitted Application[]      @relation("SubmittedBy")
  events                ApplicationEvent[]
  committeeVotes        CommitteeVote[]

  // ── CHANGED: back-relations for Assignment and Document
  assignments           Assignment[]
  documentsReviewed     Document[]         @relation("DocumentReviewer")

  @@index([role])
  @@index([companyId])
}

// ─── Company (the employer) ────────────────────────────────────

model Company {
  id               String   @id @default(cuid())
  name             String
  registrationNo   String   @unique
  kraPin           String?
  tourismLicenceNo String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users        User[]
  applications Application[]

  @@index([registrationNo])
}

// ─── Applications ──────────────────────────────────────────────

enum PermitClass {
  CLASS_G // Investor
  CLASS_D // Employee
  SPECIAL_PASS
}

enum ApplicationType {
  FIRST_APPLICATION
  RENEWAL
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_PERUSAL
  UNDER_VERIFICATION
  AWAITING_COMMITTEE
  COMMITTEE_APPROVED
  COMMITTEE_DECLINED
  AWAITING_PS_APPROVAL
  PS_APPROVED
  PS_DECLINED
  WITHDRAWN
  FORWARDED_TO_INTERIOR
}

model Application {
  id          String            @id @default(cuid())
  referenceNo String            @unique
  status      ApplicationStatus @default(DRAFT)

  submittedById String
  submittedBy   User    @relation("SubmittedBy", fields: [submittedById], references: [id])
  companyId     String
  company       Company @relation(fields: [companyId], references: [id])

  permitClass     PermitClass
  applicationType ApplicationType

  applicantName        String
  applicantNationality String
  applicantPassportNo  String
  applicantEmail       String
  applicantPhone       String
  purposeStatement     String?

  documents   Document[]
  events      ApplicationEvent[]
  votes       CommitteeVote[]
  assignments Assignment[]

  submittedAt           DateTime?
  perusalStartedAt      DateTime?
  verificationStartedAt DateTime?
  committeeDecidedAt    DateTime?
  psDecidedAt           DateTime?
  forwardedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([submittedById])
  @@index([companyId])
}

// ─── Documents ─────────────────────────────────────────────────

enum DocumentReviewStatus {
  PENDING
  ACCEPTED
  REJECTED
  NEEDS_RESUBMISSION
}

model Document {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  slotId     String
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String
  uploadedAt DateTime @default(now())

  perusalStatus      DocumentReviewStatus @default(PENDING)
  verificationStatus DocumentReviewStatus @default(PENDING)
  reviewNotes        String?

  // ── CHANGED: reviewedById is now a real relation
  reviewedById String?
  reviewedBy   User?     @relation("DocumentReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  @@unique([applicationId, slotId, fileName])
  @@index([applicationId])
  @@index([slotId])
  @@index([reviewedById])
}

// ─── Workflow events (audit trail) ─────────────────────────────

enum EventType {
  SUBMITTED
  PERUSAL_STARTED
  DOCUMENT_PERUSED
  VERIFICATION_STARTED
  DOCUMENT_VERIFIED
  ESCALATED_TO_COMMITTEE
  COMMITTEE_VOTE_CAST
  COMMITTEE_APPROVED
  COMMITTEE_DECLINED
  ESCALATED_TO_PS
  PS_APPROVED
  PS_DECLINED
  FORWARDED_TO_INTERIOR
  WITHDRAWN
  NOTE_ADDED
}

model ApplicationEvent {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  type    EventType
  actorId String?
  actor   User?     @relation(fields: [actorId], references: [id])
  message String?
  metadata Json?

  createdAt DateTime @default(now())

  @@index([applicationId, createdAt])
  @@index([actorId])
}

// ─── Committee votes ───────────────────────────────────────────

enum VoteDecision {
  APPROVE
  DECLINE
  ABSTAIN
}

model CommitteeVote {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  voterId String
  voter   User   @relation(fields: [voterId], references: [id])

  decision VoteDecision
  comment  String?

  createdAt DateTime @default(now())

  @@unique([applicationId, voterId])
  @@index([applicationId])
  @@index([voterId])
}

// ─── Assignment (who is handling this application at the current stage) ───

enum AssignmentRole {
  PERUSER
  VERIFIER
  COMMITTEE_CHAIR
  PS_REVIEWER
}

model Assignment {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  role       AssignmentRole
  // ── CHANGED: assigneeId now has a relation to User
  assigneeId String
  assignee   User   @relation(fields: [assigneeId], references: [id])
  assignedAt  DateTime       @default(now())
  completedAt DateTime?

  @@unique([applicationId, role])
  @@index([assigneeId])
}

// ─── Contact Form Submission ────────────────────────────────────

model ContactSubmission {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  createdAt DateTime @default(now())
}

// ─── Blog posts ────────────────────────────────────────────────

model Post {
  id          Int       @id @default(autoincrement())
  title       String
  slug        String    @unique
  excerpt     String
  content     String
  coverImage  String?
  tags        String    @default("")
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
}

// ─── Destinations (counties / parks / cities) ──────────────────

model Destination {
  id          Int             @id @default(autoincrement())
  name        String          @unique
  slug        String          @unique
  county      String
  description String
  imageUrl    String?
  featured    Boolean         @default(false)
  order       Int             @default(0)
  published   Boolean         @default(true)

  attractions Attraction[]
  packages    TourPackage[]
  stays       Accommodation[]

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

// ─── Attractions ───────────────────────────────────────────────

model Attraction {
  id            Int         @id @default(autoincrement())
  name          String
  slug          String      @unique
  description   String
  category      String
  imageUrl      String?
  destinationId Int
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  order         Int         @default(0)
  published     Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([destinationId])
}

// ─── Tour Packages ─────────────────────────────────────────────

model TourPackage {
  id            Int         @id @default(autoincrement())
  title         String
  slug          String      @unique
  summary       String
  description   String
  priceKes      Int
  durationDays  Int
  imageUrl      String?
  destinationId Int
  destination   Destination @relation(fields: [destinationId], references: [id])
  order         Int         @default(0)
  published     Boolean     @default(true)
  featured      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([destinationId])
}

// ─── Accommodations ────────────────────────────────────────────

model Accommodation {
  id            Int         @id @default(autoincrement())
  name          String
  slug          String      @unique
  type          String
  description   String
  location      String
  priceRange    String?
  imageUrl      String?
  destinationId Int
  destination   Destination @relation(fields: [destinationId], references: [id])
  order         Int         @default(0)
  published     Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([destinationId])
}

// ─── Events ────────────────────────────────────────────────────

model Event {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String
  startDate   DateTime
  endDate     DateTime?
  location    String
  imageUrl    String?
  featured    Boolean   @default(false)
  order       Int       @default(0)
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}